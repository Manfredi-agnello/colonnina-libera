# Ambiente Python locale
.venv/
__pycache__/
*.pyc

# Copia del progetto originale, tenuta solo come riferimento in locale
/originale/

# File generati dalla raccolta: NON vanno nella storia di Git.
# - stato/   vive su un branch separato "stato" che viene sovrascritto
# - out/     viene pubblicato direttamente sul sito
# - hub-dati/ è il repository PRIVATO della zona hub
/stato/
/out/
/hub-dati/
/hub-storico/
/report/

# Configurazione privata dell'hub (coordinate): mai nel repository pubblico
config/hub.local.json
# Chiavi di servizi esterni (es. Open Charge Map): mai nel repository
config/*.local.json
.env

# Dati di prova copiati in locale per vedere il sito (su GitHub li aggiunge il workflow)
/sito/dati/

# Documenti riservati (rischi legali, appunti personali): solo in locale
/riservato/

# Impostazioni locali degli strumenti di sviluppo
/.claude/
